OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=

# Only necessary for Open Agent Platform
SUPABASE_KEY=
SUPABASE_URL=
# Should be set to true for a production deployment on Open Agent Platform. Should be set to false otherwise, such as for local development.
GET_API_KEYS_FROM_CONFIG=false

# Configuration Overrides (optional - set via environment variables)
# These override the defaults in configuration.py. Set the UPPERCASE version of any config field.

# Concurrency & Cost Controls
# MAX_CONCURRENT_RESEARCH_UNITS=2
# MAX_TOOL_CALLS_PER_STEP=4
# MAX_PARALLEL_TOOL_CALLS=4
# MAX_QUERIES_PER_SEARCH_CALL=2
# MAX_TOTAL_SEARCH_CALLS=10
# MAX_RESULTS_PER_QUERY=3
# MAX_SUMMARIZATION_CONCURRENCY=4

# Timeouts
# SUMMARIZATION_TIMEOUT_SECONDS=45
# SUMMARIZATION_FALLBACK_MAX_CHARS=4000
# MAX_CONTENT_LENGTH=50000
# RESEARCH_TIMEOUT_SECONDS=120
# MAX_RUN_DURATION_SECONDS=600

# Iteration Limits
# MAX_RESEARCHER_ITERATIONS=4
# MAX_REACT_TOOL_CALLS=6
# MAX_STRUCTURED_OUTPUT_RETRIES=2
